{
  "name": "thebgappapi",
  "version": "1.0.0",
  "description": "board game api",
  "main": "app.js",
  "scripts": {
    "start": "node dist/app.js",
    "dev": "nodemon --exec ts-node app.ts",
    "build": "tsc",
    "build:watch": "tsc --watch",
    "test": "mocha --require ts-node/register test/**/*.test.ts",
    "test-watch": "nodemon --exec \"npm test\"",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit"
  },
  "keywords": [
    "node",
    "api"
  ],
  "author": "Zenna Liang",
  "license": "ISC",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "express-jwt": "^8.5.1",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^8.3.2",
    "express-validator": "^7.3.1",
    "formidable": "^3.5.4",
    "google-auth-library": "^10.6.2",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "lodash": "^4.17.21",
    "mongoose": "^9.3.3",
    "morgan": "^1.10.1",
    "node-forge": "^1.4.0",
    "nodemailer": "^8.0.4",
    "socket.io": "^4.8.3",
    "ws": "^8.20.0",
    "xml2js": "^0.6.2"
