      "@types/express": "^5.0.3",
      "@types/express-jwt": "^6.0.4",
      "@types/formidable": "^3.4.5",
      "@types/jsonwebtoken": "^9.0.10",
      "@types/lodash": "^4.17.20",
      "@types/mocha": "^10.0.10",
      "@types/morgan": "^1.9.10",
      "@types/node": "^24.3.1",
      "@types/nodemailer": "^7.0.1",
      "@types/socket.io": "^3.0.1",
      "@types/supertest": "^6.0.3",
      "@types/uuid": "^10.0.0",
      "@types/ws": "^8.18.1",
      "@types/xml2js": "^0.4.14",
      "chai": "^6.0.1",
      "chai-http": "^5.1.2",
