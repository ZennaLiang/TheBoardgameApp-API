      "cors-anywhere": "^0.4.4",
      "dotenv": "^17.2.2",
      "express": "^4.21.2",
      "express-jwt": "^8.5.1",
      "express-rate-limit": "^8.1.0",
      "express-validator": "^7.2.1",
      "formidable": "^3.5.4",
      "google-auth-library": "^10.3.0",
      "http-proxy": "^1.18.1",
      "jsonwebtoken": "^9.0.2",
      "lodash": "^4.17.21",
      "mongoose": "^8.18.1",
      "morgan": "^1.10.1",
      "node-forge": "^1.3.1",
      "nodemailer": "^7.0.6",
      "socket.io": "^4.8.1",
      "uuid": "^13.0.0",
      "ws": "^8.18.3",
      "xml2js": "^0.6.2"
